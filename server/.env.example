# CineScope Server — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file

# ── Database (Supabase PostgreSQL) ──────────────────────────
# Get from: Supabase → Project → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Authentication ──────────────────────────────────────────
# Generate with: openssl rand -base64 64
AUTH_SECRET="your-very-long-random-secret-key-here"
AUTH_EXPIRES_IN="7d"

# ── TMDB ────────────────────────────────────────────────────
# Get from: https://www.themoviedb.org/settings/api
TMDB_API_KEY="your-tmdb-api-key"
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE="https://image.tmdb.org/t/p"

# ── CORS / Origins ──────────────────────────────────────────
# Comma-separated list of allowed origins
PUBLIC_SITE_URL="https://cinescopecodespactor.netlify.app"
ADMIN_APP_URL="https://your-admin-dashboard.netlify.app"
CORS_ORIGINS="https://cinescopecodespactor.netlify.app,https://your-admin-dashboard.netlify.app"

# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

